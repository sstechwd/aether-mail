# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp

# Env / secrets — never commit
.env
.env.*
!.env.example

# Rust
target/
**/*.rs.bk

# Node / frontend (Phase 1+)
node_modules/
dist/
dist-ssr/
*.local

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/gen/

# Built sidecar: an 89MB Node runtime with the API embedded. Rebuild it with
# `npm run sidecar:build` — never commit it.
apps/desktop/sidecar/*.exe
apps/desktop/sidecar/aether-api.cjs
apps/desktop/sidecar/aether-api.mjs
apps/desktop/sidecar/*.blob

# Test / local data
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
data/*.json
data/*.jsonl
# SQLite mail store — real mailbox contents. The repo is public; these must
# never be committed. -wal/-shm are the WAL sidecar files.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.bak

# Hermes local plans may be committed; caches may not
.hermes/cache/
.hermes/focus-app.ps1
.hermes/ram.ps1
.hermes/branch-protection.json

# Profile backups contain real mailbox contents.
backups/
data/tokens.json
data/syncstate.json
